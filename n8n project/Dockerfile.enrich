# FastAPI enrichment microservice.
# uvicorn (an ASGI web server) serves the app directly on port 6789.
FROM python:3.12-slim

# Python dependencies.
RUN pip install --no-cache-dir \
      "fastapi==0.115.6" \
      "uvicorn[standard]==0.34.0" \
      "pydantic==2.10.4"

WORKDIR /app
COPY enrichapi.py /app/enrichapi.py

EXPOSE 6789

# 0.0.0.0 so the container accepts connections from other containers on the network.
CMD ["uvicorn", "enrichapi:app", "--host", "0.0.0.0", "--port", "6789"]
