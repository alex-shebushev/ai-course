    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# n8n Code node — Language: Python (native runner), \"Run Once for All Items\"\n# Extracts text from an inline-binary PDF using PyMuPDF (fitz).\n#\n# PyMuPDF is NOT stdlib — the native runner needs:\n#   1. custom image:  FROM n8nio/runners:latest\n#                     RUN /opt/runners/task-runner-python/.venv/bin/pip install --no-cache-dir PyMuPDF\n#   2. allowlist:     N8N_RUNNERS_EXTERNAL_ALLOW=pymupdf\n\nimport base64\n\nimport fitz  # PyMuPDF\n\nBINARY_PROPERTY = \"data\"  # binary property holding the .pdf; change if yours differs\n\n\ndef extract_text(pdf_bytes):\n    \"\"\"Pull text out of a PDF, page by page, in reading order.\"\"\"\n    pages = []\n    doc = fitz.open(stream=pdf_bytes, filetype=\"pdf\")\n    try:\n        for page in doc:\n            pages.append(page.get_text(\"text\"))\n    finally:\n        doc.close()\n    return \"\\n\".join(pages)\n\n\noutput = []\n\nfor item in _items:\n    binary = item.get(\"binary\") or {}\n    entry = binary.get(BINARY_PROPERTY)\n    if not entry or not entry.get(\"data\"):\n        raise ValueError(\n            \"No binary data found on property '%s'. \"\n            \"Check the binary property name.\" % BINARY_PROPERTY\n        )\n\n    pdf_bytes = base64.b64decode(entry[\"data\"])\n    text = extract_text(pdf_bytes)\n\n    output.append({\"json\": {\"text\": text}})\n\nreturn output"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
