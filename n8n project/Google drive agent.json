    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# ============================================================\n# n8n Code node — Language: Python (native runner)\n# Mode: \"Run Once for All Items\"\n#\n# Extracts text from a .docx file provided as inline binary.\n#\n# Works when n8n stores binary IN MEMORY (N8N_DEFAULT_BINARY_DATA_MODE=default),\n# so item[\"binary\"][\"<property>\"][\"data\"] is the base64 of the file itself\n# (first chars \"UEsDBBQ...\", which decodes to PK\\x03\\x04 — a zip/.docx).\n#\n# If you ever switch to filesystem/S3 binary mode, that \"data\" field becomes\n# a reference string (\"filesystem-v2\") instead of base64 — then put an\n# \"Extract from File\" node (Move File to Base64 String) before this one and\n# read item[\"json\"][...] instead.\n#\n# Needs these stdlib modules allowed (N8N_RUNNERS_STDLIB_ALLOW):\n#     base64, io, zipfile, xml\n# ============================================================\n\nimport base64\nimport io\nimport zipfile\nimport xml.etree.ElementTree as ET\n\n# Binary property that holds the .docx file. Change if yours differs.\nBINARY_PROPERTY = \"data\"\n\nWORD_NS = \"{http://schemas.openxmlformats.org/wordprocessingml/2006/main}\"\n\n\ndef extract_text(docx_bytes):\n    \"\"\"Pull paragraph text out of a .docx (a zip of XML parts).\"\"\"\n    paragraphs = []\n    with zipfile.ZipFile(io.BytesIO(docx_bytes)) as z:\n        with z.open(\"word/document.xml\") as f:\n            tree = ET.parse(f)\n    for para in tree.getroot().iter(WORD_NS + \"p\"):\n        texts = [node.text for node in para.iter(WORD_NS + \"t\") if node.text]\n        paragraphs.append(\"\".join(texts))\n    return \"\\n\".join(paragraphs)\n\n\noutput = []\n\nfor item in _items:\n    binary = item.get(\"binary\") or {}\n    entry = binary.get(BINARY_PROPERTY)\n    if not entry or not entry.get(\"data\"):\n        raise ValueError(\n            \"No binary data found on property '%s'. \"\n            \"Check the binary property name.\" % BINARY_PROPERTY\n        )\n\n    docx_bytes = base64.b64decode(entry[\"data\"])\n    text = extract_text(docx_bytes)\n\n    output.append({\"json\": {\"text\": text}})\n\nreturn output\n"
      },
